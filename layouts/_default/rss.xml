{{- $pages := cond .IsHome .Site.RegularPages .RegularPagesRecursive -}}
{{- $pages = (where (where $pages "Params.rss_exclude" "!=" true) "Section" "!=" "photography").ByDate.Reverse -}}
{{- $base := site.Home.Permalink -}}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
	<title>{{ if .IsHome }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{ . }} on {{ end }}{{ .Site.Title }}{{ end }}</title>
	<link>{{ .Permalink }}</link>
	<description>Recent content {{ if not .IsHome }}{{ with .Title }}in {{ . }} {{ end }}{{ end }}on {{ .Site.Title }}</description>
	<generator>Hugo -- gohugo.io</generator>{{ with .Site.Language.Lang }}
	<language>{{.}}</language>{{end}}{{ with .Site.Copyright }}
	<copyright>{{.}}</copyright>{{end}}
	{{- with $pages }}
	<lastBuildDate>{{ (index . 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
	{{- else }}{{ if not .Date.IsZero }}
	<lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
	{{- end }}{{ end }}
    {{ with .OutputFormats.Get "RSS" }}
        {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
	{{ end }}
	{{ range $pages }}
    {{- $content := .Content | replaceRE `(src|href|poster)="/(|[^/"][^"]*)"` (printf `${1}="%s${2}"` $base) -}}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{- $content | html -}}</description>
    </item>
    {{ end }}
	</channel>
</rss>
